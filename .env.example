# Public demo runs without environment variables.
# Real connectors should be implemented server-side and kept outside the browser.
LCP_DEMO_MODE=true

# Private builds use one Vercel account session on desktop and mobile as the
# actual access boundary. `npm run deploy:private` sets this automatically.
VITE_PLATFORM_AUTH=false

# Optional product API. When absent, Car Plane uses synthetic demo data and
# stores manual demo readings only in the current browser.
VITE_VEHICLE_API_URL=

# Optional server-side content connector. Never place YouTube/TikTok client
# secrets in Vite variables; this URL may point only to a trusted private API.
VITE_CONTENT_API_URL=

# The private deployment defaults to the encrypted connector service at
# api.datahiringiq.com. No OAuth secret or provider token belongs in Vite.

# Optional local build-time inputs. They are read by the snapshot generator and
# are never included in Git history.
LCP_PROJECT_ROOT=
HUMAN_REPO_ROOT=
LCP_PRIVATE_DATA_FILE=
